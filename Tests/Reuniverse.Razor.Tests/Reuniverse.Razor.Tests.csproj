<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="bunit" Version="2.13.3" />
        <PackageReference Include="Deque.AxeCore.Playwright" Version="4.14.0" />
        <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
        <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="9.0.11" Condition="'$(TargetFramework)' == 'net9.0'" />
        <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="10.0.2" Condition="'$(TargetFramework)' == 'net10.0'" />
        <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
        <PackageReference Include="TUnit" Version="1.78.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Src\Reuniverse.Razor\Reuniverse.Razor.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\Src\Reuniverse.Razor\wwwroot\*.js;..\..\Src\Reuniverse.Razor\wwwroot\*.css;..\..\Src\Reuniverse.Razor\*.razor.js"
              Link="Scripts\%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" />
        <!-- the styles of the components themselves, which the library builds before this project copies them -->
        <None Include="..\..\Src\Reuniverse.Razor\obj\$(Configuration)\$(TargetFramework)\scopedcss\bundle\Reuniverse.Razor.styles.css"
              Link="Scripts\Reuniverse.Razor.styles.css"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- the scoped styles of QuickGrid, from the package version this framework uses, which the Reu theme has to win over -->
    <Target Name="CopyQuickGridStyles" AfterTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <_QuickGridReference Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Microsoft.AspNetCore.Components.QuickGrid'" />
        </ItemGroup>
        <PropertyGroup>
            <_QuickGridVersion>@(_QuickGridReference->'%(NuGetPackageVersion)')</_QuickGridVersion>
        </PropertyGroup>
        <ItemGroup>
            <_QuickGridStyles Include="$(NuGetPackageRoot)microsoft.aspnetcore.components.quickgrid\$(_QuickGridVersion)\staticwebassets\*.bundle.scp.css" />
        </ItemGroup>
        <Error Condition="'@(_QuickGridStyles)' == ''" Text="The styles of QuickGrid $(_QuickGridVersion) were not found." />
        <Copy SourceFiles="@(_QuickGridStyles)" DestinationFiles="$(OutDir)Scripts\QuickGrid.styles.css" SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <Using Include="Bunit" />
        <!-- bUnit has an obsolete class of the same name, which breaks the code TUnit generates for hooks -->
        <Using Include="TUnit.Core.TestContext" Alias="TestContext" />
    </ItemGroup>

</Project>
