<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="bunit" Version="2.13.3" />
        <PackageReference Include="Deque.AxeCore.Playwright" Version="4.14.0" />
        <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
        <PackageReference Include="TUnit" Version="1.78.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Src\Reuniverse.Razor\Reuniverse.Razor.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\Src\Reuniverse.Razor\wwwroot\*.js;..\..\Src\Reuniverse.Razor\wwwroot\*.css;..\..\Src\Reuniverse.Razor\*.razor.js"
              Link="Scripts\%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" />
        <!-- the styles of the components themselves, which the library builds before this project copies them -->
        <None Include="..\..\Src\Reuniverse.Razor\obj\$(Configuration)\$(TargetFramework)\scopedcss\bundle\Reuniverse.Razor.styles.css"
              Link="Scripts\Reuniverse.Razor.styles.css"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Bunit" />
        <!-- bUnit has an obsolete class of the same name, which breaks the code TUnit generates for hooks -->
        <Using Include="TUnit.Core.TestContext" Alias="TestContext" />
    </ItemGroup>

</Project>
