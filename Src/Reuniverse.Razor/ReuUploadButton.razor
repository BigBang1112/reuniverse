@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@implements IAsyncDisposable

<ReuButton CssClass="@($"reu-upload-button {CssClass}")" Enable="Enable" Variant="Variant" Tooltip="@Tooltip" Active="dragged">
    @if (RendererInfo.IsInteractive)
    {
        @ChildContent
        
        @if (Streamed)
        {
            <InputFile OnChange="ChangeAsync"
                       @ref="inputFileStreamed"
                       @ondragenter="DragEnter"
                       @ondragleave="DragEnd"
                       @ondragend="DragEnd"
                       @ondrop="DragEnd" class="file" accept="@Accept"
                       multiple="@(MaxFileCount is null or > 1)"
                       @attributes="AdditionalAttributes" />
        }
        else
        {
            <input type="file"
                   @ref="inputFileUpload"
                   @ondragenter="DragEnter"
                   @ondragleave="DragEnd"
                   @ondragend="DragEnd"
                   @ondrop="DragEnd"
                   accept="@Accept"
                   multiple="@(MaxFileCount is null or > 1)"
                   @attributes="AdditionalAttributes" />
        }
    }
    else
    {
        <ReuLoader Size="LoaderSize" Thickness="LoaderThickness"></ReuLoader>
    }
</ReuButton>

@code {
    private InputFile? inputFileStreamed;
    private ElementReference inputFileUpload;
    private IJSObjectReference? module;
    private DotNetObjectReference<ReuUploadButton>? objRef;

    private bool dragged;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether the button is enabled.
    /// </summary>
    [Parameter]
    public bool Enable { get; set; } = true;

    /// <summary>
    /// The variant style of the button.
    /// </summary>
    [Parameter]
    public ReuButtonVariant Variant { get; set; } = ReuButtonVariant.Default;

    /// <summary>
    /// The tooltip text to display on hover.
    /// </summary>
    [Parameter]
    public string? Tooltip { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the button.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Whether the button is disabled.
    /// </summary>
    public bool Disabled => !Enable;

    /// <summary>
    /// Callback invoked when files are uploaded.
    /// </summary>
    [Parameter]
    public EventCallback<UploadEventArgs> OnUpload { get; set; }

    /// <summary>
    /// Callback invoked when a file is too large.
    /// </summary>
    [Parameter]
    public EventCallback<FileInfoEventArgs> OnFileTooLarge { get; set; }

    /// <summary>
    /// Callback invoked when the file count exceeds the maximum.
    /// </summary>
    [Parameter]
    public EventCallback<FileInfoEventArgs> OnFileExceedCount { get; set; }

    /// <summary>
    /// Maximum number of files allowed in a single selection. Null is the default which means no limit. This does not limit the total number of files a client can upload, as each new selection starts over.
    /// </summary>
    [Parameter]
    public int? MaxFileCount { get; set; }

    /// <summary>
    /// Maximum file size in bytes. Null is the default which means no limit. Make sure to set limits if in serverside interactivity!
    /// </summary>
    [Parameter]
    public long? MaxFileSize { get; set; }

    /// <summary>
    /// A comma-separated list of one or more file types, or unique file type specifiers, describing which file types to allow.
    /// </summary>
    [Parameter]
    public string? Accept { get; set; }

    /// <summary>
    /// The size of the loader in pixels.
    /// </summary>
    [Parameter]
    public int LoaderSize { get; set; } = 50;

    /// <summary>
    /// The thickness of the loader border in pixels.
    /// </summary>
    [Parameter]
    public int LoaderThickness { get; set; } = 8;

    [Parameter]
    public bool Streamed { get; set; }

    [Parameter]
    public EventCallback<StreamEventArgs> OnStream { get; set; }

    protected override void OnInitialized() =>
        objRef = DotNetObjectReference.Create(this);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", $"./_content/Reuniverse.Razor/ReuUploadButton.razor.js");
            await module.InvokeVoidAsync("addHandlers", inputFileStreamed?.Element ?? inputFileUpload, objRef, Streamed);
        }
    }

    [JSInvokable]
    public async Task UploadAsync(string fileName, byte[] data, long lastModified, string type)
    {
        var modified = DateTimeOffset.FromUnixTimeMilliseconds(lastModified);

        // the JS check can be bypassed, as a client can invoke this method directly in serverside interactivity
        if (MaxFileSize > 0 && data.Length > MaxFileSize)
        {
            await OnFileTooLarge.InvokeAsync(new FileInfoEventArgs(fileName, data.Length, modified, type));
            return;
        }

        await OnUpload.InvokeAsync(new UploadEventArgs(fileName, data, modified, type));
    }

    [JSInvokable]
    public Task<int> GetMaxFileCountAsync() => Task.FromResult(MaxFileCount ?? 0);

    [JSInvokable]
    public Task<long> GetMaxFileSizeAsync() => Task.FromResult(MaxFileSize ?? 0);

    [JSInvokable]
    public async Task OnFileTooLargeAsync(string fileName, long size, long lastModified, string type)
    {
        await OnFileTooLarge.InvokeAsync(new FileInfoEventArgs(fileName, size, DateTimeOffset.FromUnixTimeMilliseconds(lastModified), type));
    }

    [JSInvokable]
    public async Task OnFileExceedCountAsync(string fileName, long size, long lastModified, string type)
    {
        await OnFileExceedCount.InvokeAsync(new FileInfoEventArgs(fileName, size, DateTimeOffset.FromUnixTimeMilliseconds(lastModified), type));
    }

    private void DragEnter(DragEventArgs e)
    {
        dragged = true;
    }

    private void DragEnd()
    {
        dragged = false;
    }

    private async Task ChangeAsync(InputFileChangeEventArgs e)
    {
        // GetMultipleFiles(max) throws when more files are supplied, so limits are checked per file like in the JS upload
        var files = e.GetMultipleFiles(e.FileCount);

        for (var i = 0; i < files.Count; i++)
        {
            var file = files[i];

            if (MaxFileCount > 0 && i >= MaxFileCount)
            {
                await OnFileExceedCount.InvokeAsync(new FileInfoEventArgs(file.Name, file.Size, file.LastModified, file.ContentType));
                continue;
            }

            if (MaxFileSize > 0 && file.Size > MaxFileSize)
            {
                await OnFileTooLarge.InvokeAsync(new FileInfoEventArgs(file.Name, file.Size, file.LastModified, file.ContentType));
                continue;
            }

            var stream = file.OpenReadStream(long.MaxValue);
            await OnStream.InvokeAsync(new StreamEventArgs(file.Name, file.Size, stream, file.LastModified));
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        objRef?.Dispose();
    }
}