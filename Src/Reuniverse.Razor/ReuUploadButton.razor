@inject IJSRuntime JS
@implements IAsyncDisposable

<ReuButton CssClass="@($"reu-upload-button {CssClass}")" Enable="Enable" Variant="Variant" Tooltip="@Tooltip" Active="dragged">
    @if (RendererInfo.IsInteractive)
    {
        @ChildContent
        <input type="file"
               @ref="inputFileUpload"
               @ondragenter="DragEnter"
               @ondragleave="DragEnd"
               @ondragend="DragEnd"
               @ondrop="DragEnd"
               accept="@Accept"
               multiple="@(MaxFileCount is null or > 1)"
               webkitdirectory="@Directory"
               data-reu-paste="@Paste"
               @attributes="AdditionalAttributes" />
    }
    else
    {
        <ReuLoader Size="LoaderSize" Thickness="LoaderThickness"></ReuLoader>
    }
</ReuButton>

@code {
    private ElementReference inputFileUpload;
    private IJSObjectReference? module;
    private DotNetObjectReference<ReuUploadButton>? objRef;

    private bool dragged;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether the button is enabled.
    /// </summary>
    [Parameter]
    public bool Enable { get; set; } = true;

    /// <summary>
    /// The variant style of the button.
    /// </summary>
    [Parameter]
    public ReuButtonVariant Variant { get; set; } = ReuButtonVariant.Default;

    /// <summary>
    /// The tooltip text to display on hover.
    /// </summary>
    [Parameter]
    public string? Tooltip { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the button.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Whether to pick a folder instead of files. Every file in the folder and its subfolders that matches <see cref="Accept"/> is uploaded,
    /// with its path within the folder in <c>RelativePath</c>. Dropping a folder also works.
    /// </summary>
    [Parameter]
    public bool Directory { get; set; }

    /// <summary>
    /// Whether files pasted anywhere on the page (Ctrl+V) are uploaded, filtered by <see cref="Accept"/>. Pasting into a text field is left alone.
    /// Turn it on for only one upload component on a page, as each of them would take the pasted files.
    /// </summary>
    [Parameter]
    public bool Paste { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Whether the button is disabled.
    /// </summary>
    public bool Disabled => !Enable;

    /// <summary>
    /// Callback invoked when files are uploaded.
    /// </summary>
    [Parameter]
    public EventCallback<UploadEventArgs> OnUpload { get; set; }

    /// <summary>
    /// Callback invoked when a file is too large.
    /// </summary>
    [Parameter]
    public EventCallback<FileInfoEventArgs> OnFileTooLarge { get; set; }

    /// <summary>
    /// Callback invoked when the file count exceeds the maximum.
    /// </summary>
    [Parameter]
    public EventCallback<FileInfoEventArgs> OnFileExceedCount { get; set; }

    /// <summary>
    /// Maximum number of files allowed in a single selection. Null is the default which means no limit. This does not limit the total number of files a client can upload, as each new selection starts over.
    /// </summary>
    [Parameter]
    public int? MaxFileCount { get; set; }

    /// <summary>
    /// Maximum file size in bytes. Null is the default which means no limit. Make sure to set limits if in serverside interactivity!
    /// </summary>
    [Parameter]
    public long? MaxFileSize { get; set; }

    /// <summary>
    /// A comma-separated list of one or more file types, or unique file type specifiers, describing which file types to allow.
    /// </summary>
    [Parameter]
    public string? Accept { get; set; }

    /// <summary>
    /// The size of the loader in pixels.
    /// </summary>
    [Parameter]
    public int LoaderSize { get; set; } = 50;

    /// <summary>
    /// The thickness of the loader border in pixels.
    /// </summary>
    [Parameter]
    public int LoaderThickness { get; set; } = 8;

    /// <summary>
    /// Whether files are opened as seekable streams through <see cref="OnStream"/> instead of being uploaded whole through <see cref="OnUpload"/>.
    /// The streams read the file in ranges on demand, so large files are never loaded into memory.
    /// </summary>
    [Parameter]
    public bool Streamed { get; set; }

    /// <summary>
    /// Callback invoked for each file when <see cref="Streamed"/> is true, with a seekable <see cref="ReuBrowserFileStream"/>.
    /// The handler owns the stream and should dispose it, which releases the file on the client.
    /// </summary>
    [Parameter]
    public EventCallback<StreamEventArgs> OnStream { get; set; }

    protected override void OnInitialized() =>
        objRef = DotNetObjectReference.Create(this);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", $"./_content/Reuniverse.Razor/ReuUploadButton.razor.js");
            await module.InvokeVoidAsync("addHandlers", inputFileUpload, objRef, Streamed);
        }
    }

    [JSInvokable]
    public async Task UploadAsync(string fileName, byte[] data, long lastModified, string type, string? relativePath)
    {
        var modified = DateTimeOffset.FromUnixTimeMilliseconds(lastModified);

        // the JS check can be bypassed, as a client can invoke this method directly in serverside interactivity
        if (MaxFileSize > 0 && data.Length > MaxFileSize)
        {
            await OnFileTooLarge.InvokeAsync(new FileInfoEventArgs(fileName, data.Length, modified, type) { RelativePath = relativePath });
            return;
        }

        await OnUpload.InvokeAsync(new UploadEventArgs(fileName, data, modified, type) { RelativePath = relativePath });
    }

    [JSInvokable]
    public async Task OpenStreamAsync(IJSObjectReference file, string fileName, long size, long lastModified, string type, string? relativePath)
    {
        var modified = DateTimeOffset.FromUnixTimeMilliseconds(lastModified);

        // the JS check can be bypassed, as a client can invoke this method directly in serverside interactivity
        // the stream never reads past the reported size, so checking the size is enough
        if (MaxFileSize > 0 && size > MaxFileSize)
        {
            await file.DisposeAsync();
            await OnFileTooLarge.InvokeAsync(new FileInfoEventArgs(fileName, size, modified, type) { RelativePath = relativePath });
            return;
        }

        if (size < 0 || !OnStream.HasDelegate)
        {
            await file.DisposeAsync();
            return;
        }

        // the handler owns the stream and disposes it, which releases the file on the client

        await OnStream.InvokeAsync(new StreamEventArgs(fileName, size, ReuBrowserFileStream.Create(file, size), modified) { RelativePath = relativePath });
    }

    [JSInvokable]
    public Task<int> GetMaxFileCountAsync() => Task.FromResult(MaxFileCount ?? 0);

    [JSInvokable]
    public Task<long> GetMaxFileSizeAsync() => Task.FromResult(MaxFileSize ?? 0);

    [JSInvokable]
    public async Task OnFileTooLargeAsync(string fileName, long size, long lastModified, string type, string? relativePath)
    {
        await OnFileTooLarge.InvokeAsync(new FileInfoEventArgs(fileName, size, DateTimeOffset.FromUnixTimeMilliseconds(lastModified), type) { RelativePath = relativePath });
    }

    [JSInvokable]
    public async Task OnFileExceedCountAsync(string fileName, long size, long lastModified, string type, string? relativePath)
    {
        await OnFileExceedCount.InvokeAsync(new FileInfoEventArgs(fileName, size, DateTimeOffset.FromUnixTimeMilliseconds(lastModified), type) { RelativePath = relativePath });
    }

    private void DragEnter(DragEventArgs e)
    {
        dragged = true;
    }

    private void DragEnd()
    {
        dragged = false;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("removeHandlers", inputFileUpload);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        objRef?.Dispose();
    }
}