@using Microsoft.AspNetCore.Components.Routing

<div class="navbar @CssClass @(IsAbsolute ? "absolute" : "")" @attributes="AdditionalAttributes">
    <div class="reu-container">
        <div class="nav-brand">
            <a class="brand" href="">@Brand</a>
        </div>

        <label class="nav-toggle">
            <input type="checkbox" aria-label="Menu" />
            @if (string.IsNullOrEmpty(BurgerImageSrc))
            {
                <span class="nav-toggle-icon reu-mask-icon" style="mask-image: url('@(Consts.BaseDir)/icons/menu.svg');"></span>
            }
            else
            {
                <img src="@BurgerImageSrc" alt="" width="32" height="32" />
            }
        </label>

        <nav>
            @ChildContent
        </nav>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Brand { get; set; }

    [Parameter]
    public string? BurgerImageSrc { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Whether to place the bar over the page content instead of above it.
    /// </summary>
    [Parameter]
    public bool IsAbsolute { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
