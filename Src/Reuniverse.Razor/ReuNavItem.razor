@using Microsoft.AspNetCore.Components.Routing

@if (ChildContent is null)
{
    @Item
}
else
{
    <div class="nav-submenu">
        @Item
        <div class="nav-submenu-items">
            @ChildContent
        </div>
    </div>
}

@code {
    /// <summary>
    /// Nested <see cref="ReuNavItem"/> elements, shown as a submenu when hovering or focusing this item.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool IsNavLink { get; set; } = true;

    [Parameter]
    public NavLinkMatch NavLinkMatch { get; set; }

    [Parameter]
    public string? IconSrc { get; set; }

    [Parameter]
    public bool IconOnly { get; set; }

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? AltName { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public int IconWidth { get; set; } = 32;

    [Parameter]
    public int IconHeight { get; set; } = 32;

    [Parameter]
    public IconType IconType { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool HasBundledIcon => IconType != IconType.None;
    private bool HasIcon => HasBundledIcon || !string.IsNullOrEmpty(IconSrc);

    // without a link, this is the only way for the keyboard to reach the submenu
    private string? LinkTabIndex => ChildContent is not null && Href is null ? "0" : null;

    private string IconClass => IconOnly ? "icon nav-icon-standalone" : "icon";
    private string IconSizeStyle => $"--icon-width: {IconWidth}px; --icon-height: {IconHeight}px;";

    // without an icon, the label is the only thing left to show in the icon layout
    private string LabelClass => IconOnly ? "nav-label nav-item-label" : HasIcon ? "nav-label" : "nav-label nav-label-only";

    private string LinkClass => string.Join(' ', new[]
    {
        "nav-link",
        IconOnly ? null : "wide",
        IconType == IconType.Discord ? "reu-discord" : null,
        IconType == IconType.NuGet ? "reu-nuget" : null
    }.OfType<string>());

    private RenderFragment Item => @<div class="nav-item @CssClass" title="@(Title ?? Name)" @attributes="AdditionalAttributes">
        @* NavLink would count going nowhere as being on the current page *@
        @if (IsNavLink && Href is not null)
        {
            <NavLink class="@LinkClass" href="@Href" Match="NavLinkMatch">@LinkContent</NavLink>
        }
        else
        {
            <a class="@LinkClass" href="@Href" tabindex="@LinkTabIndex">@LinkContent</a>
        }
    </div>;

    private RenderFragment LinkContent => @<text>
        @if (HasBundledIcon)
        {
            <span class="@IconClass reu-mask-icon"
                  role="img"
                  aria-label="@(AltName ?? Name)"
                  style="@($"mask-image: url('{Consts.BaseDir}/icons/{IconType.ToString().ToLowerInvariant()}.svg'); {IconSizeStyle}")"></span>
        }
        else if (HasIcon)
        {
            <img src="@IconSrc" alt="@(AltName ?? Name)" class="@IconClass" style="@IconSizeStyle" width="@IconWidth" height="@IconHeight" />
        }
        @if (!string.IsNullOrEmpty(Name))
        {
            <span class="@LabelClass">@Name</span>
        }
    </text>;
}