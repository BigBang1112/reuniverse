<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <PackageId>Reuniverse.Razor</PackageId>
        <Version>0.12.1</Version>
        <Authors>BigBang1112</Authors>
        <Description>Common Blazor components for BigBang1112 projects (gbx.tools).</Description>
        <Copyright>Copyright (c) 2026 Petr Pivoňka</Copyright>
        <PackageProjectUrl>https://github.com/BigBang1112/reuniverse</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>reuniverse, razor, blazor, gbx</PackageTags>
        <PackageReleaseNotes>
- **Added .NET 11 support**
        </PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
        <NoWarn>1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Reuniverse.Razor.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.11" Condition="'$(TargetFramework)' == 'net9.0'" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.2" Condition="'$(TargetFramework)' == 'net10.0'" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Exceptions\" />
    </ItemGroup>

    <!-- The global stylesheet and scripts are also shipped as .min files next to them, minified by esbuild, which needs Node.js.
         They are made in every configuration, as an app that references them needs them in Debug too.
         Pass -p:ReuMinifyAssets=false to make the .min files plain copies, without Node.js. -->
    <PropertyGroup>
        <ReuMinifyAssets Condition="'$(ReuMinifyAssets)' == ''">true</ReuMinifyAssets>
        <EsbuildVersion>0.28.2</EsbuildVersion>
    </PropertyGroup>

    <ItemGroup>
        <ReuMinifiedAsset Include="wwwroot\reuniverse.css;wwwroot\reuniverse.js;wwwroot\reuniverse.theme.js" />
    </ItemGroup>

    <!-- IntermediateOutputPath is only set after the project body, so the output folder is in its own target.
         The copies have their own folder, so that switching ReuMinifyAssets does not leave the other ones up to date. -->
    <Target Name="_ReuResolveMinifiedDir">
        <PropertyGroup>
            <_ReuMinifiedDir Condition="'$(ReuMinifyAssets)' == 'true'">$(IntermediateOutputPath)minified\</_ReuMinifiedDir>
            <_ReuMinifiedDir Condition="'$(ReuMinifyAssets)' != 'true'">$(IntermediateOutputPath)unminified\</_ReuMinifiedDir>
        </PropertyGroup>
    </Target>

    <Target Name="_ReuMinifyAssets"
            DependsOnTargets="_ReuResolveMinifiedDir"
            Inputs="@(ReuMinifiedAsset);$(MSBuildProjectFullPath)"
            Outputs="@(ReuMinifiedAsset->'$(_ReuMinifiedDir)%(Filename).min%(Extension)')">
        <Exec Condition="'$(ReuMinifyAssets)' == 'true'"
              Command="npx --yes esbuild@$(EsbuildVersion) @(ReuMinifiedAsset->'&quot;%(Identity)&quot;', ' ') --minify --out-extension:.css=.min.css --out-extension:.js=.min.js --outdir=&quot;$(_ReuMinifiedDir.TrimEnd('\'))&quot; --log-level=warning"
              ContinueOnError="true">
            <Output TaskParameter="ExitCode" PropertyName="_ReuEsbuildExitCode" />
        </Exec>
        <Error Condition="'$(ReuMinifyAssets)' == 'true' And '$(_ReuEsbuildExitCode)' != '0'"
               Text="Minifying the static assets with esbuild failed. It needs Node.js (npx) on the PATH. Pass -p:ReuMinifyAssets=false to make the .min files plain copies." />
        <Copy Condition="'$(ReuMinifyAssets)' != 'true'"
              SourceFiles="@(ReuMinifiedAsset)"
              DestinationFiles="@(ReuMinifiedAsset->'$(_ReuMinifiedDir)%(Filename).min%(Extension)')" />
    </Target>

    <!-- Adds the .min files to wwwroot before the SDK turns it into static web assets, so they are served and packed with the rest. -->
    <Target Name="_ReuAddMinifiedAssets"
            DependsOnTargets="_ReuMinifyAssets"
            BeforeTargets="ResolveProjectStaticWebAssets">
        <ItemGroup>
            <_ReuMinifiedFile Include="@(ReuMinifiedAsset->'$(_ReuMinifiedDir)%(Filename).min%(Extension)')" />
            <Content Include="@(_ReuMinifiedFile)"
                     Link="wwwroot\%(_ReuMinifiedFile.Filename)%(_ReuMinifiedFile.Extension)"
                     ContentRoot="$(MSBuildProjectDirectory)\$(_ReuMinifiedDir)" />
            <FileWrites Include="@(_ReuMinifiedFile)" />
        </ItemGroup>
    </Target>

    <!-- The isolated styles (.razor.css) and scripts (.razor.js) of the components are minified too, also by esbuild.
         They replace the readable ones, as the components load them by their names, so it is only done in Release by default,
         which is what the package is built in. Pass -p:ReuMinifyIsolatedAssets=true or false to choose otherwise. -->
    <PropertyGroup>
        <ReuMinifyIsolatedAssets Condition="'$(ReuMinifyIsolatedAssets)' == '' And '$(Configuration)' == 'Release' And '$(ReuMinifyAssets)' == 'true'">true</ReuMinifyIsolatedAssets>
    </PropertyGroup>

    <!-- The SDK writes each scoped stylesheet to obj as .rz.scp.css and bundles them afterwards, so minifying them in place there
         carries over to the bundles, their integrity and the package. A stamp tells when they were last minified, as the SDK only
         writes them again when the .razor.css files change. -->
    <Target Name="_ReuMinifyScopedCss"
            AfterTargets="_ProcessScopedCssFiles"
            Condition="'$(ReuMinifyIsolatedAssets)' == 'true' And '@(_ScopedCss)' != ''"
            Inputs="@(_ScopedCssOutputs)"
            Outputs="$(_ScopedCssIntermediatePath)reu-minified.stamp">
        <Exec Command="npx --yes esbuild@$(EsbuildVersion) @(_ScopedCssOutputs->'&quot;%(FullPath)&quot;', ' ') --minify --allow-overwrite --outbase=&quot;$([System.IO.Path]::GetFullPath('$(_ScopedCssIntermediatePath)').TrimEnd('\'))&quot; --outdir=&quot;$([System.IO.Path]::GetFullPath('$(_ScopedCssIntermediatePath)').TrimEnd('\'))&quot; --log-level=warning"
              ContinueOnError="true">
            <Output TaskParameter="ExitCode" PropertyName="_ReuEsbuildScopedCssExitCode" />
        </Exec>
        <Error Condition="'$(_ReuEsbuildScopedCssExitCode)' != '0'"
               Text="Minifying the scoped styles with esbuild failed. It needs Node.js (npx) on the PATH. Pass -p:ReuMinifyIsolatedAssets=false to keep them as they are." />
        <Touch Files="$(_ScopedCssIntermediatePath)reu-minified.stamp" AlwaysCreate="true" />
        <ItemGroup>
            <FileWrites Include="$(_ScopedCssIntermediatePath)reu-minified.stamp" />
        </ItemGroup>
    </Target>

    <!-- The minified scoped styles stay until the SDK writes them again, so turning minifying off removes them along with the stamp. -->
    <Target Name="_ReuForgetMinifiedScopedCss"
            BeforeTargets="_ProcessScopedCssFiles"
            DependsOnTargets="ResolveScopedCssOutputs"
            Condition="'$(ReuMinifyIsolatedAssets)' != 'true' And Exists('$(_ScopedCssIntermediatePath)reu-minified.stamp')">
        <Delete Files="@(_ScopedCssOutputs);$(_ScopedCssIntermediatePath)reu-minified.stamp" />
    </Target>

    <Target Name="_ReuResolveJsModules">
        <PropertyGroup>
            <_ReuMinifiedJsModulesDir>$(IntermediateOutputPath)minified-jsmodules\</_ReuMinifiedJsModulesDir>
        </PropertyGroup>
        <ItemGroup>
            <_ReuJsModule Include="@(None)" Condition="'%(Extension)' == '.js' And $([System.String]::Copy('%(Filename)').EndsWith('.razor'))">
                <ReuRelativePath>%(RecursiveDir)%(Filename)%(Extension)</ReuRelativePath>
            </_ReuJsModule>
        </ItemGroup>
    </Target>

    <Target Name="_ReuMinifyJsModuleFiles"
            DependsOnTargets="_ReuResolveJsModules"
            Inputs="@(_ReuJsModule);$(MSBuildProjectFullPath)"
            Outputs="@(_ReuJsModule->'$(_ReuMinifiedJsModulesDir)%(ReuRelativePath)')">
        <Exec Command="npx --yes esbuild@$(EsbuildVersion) @(_ReuJsModule->'&quot;%(FullPath)&quot;', ' ') --minify --outbase=&quot;$(MSBuildProjectDirectory)&quot; --outdir=&quot;$(MSBuildProjectDirectory)\$(_ReuMinifiedJsModulesDir.TrimEnd('\'))&quot; --log-level=warning"
              ContinueOnError="true">
            <Output TaskParameter="ExitCode" PropertyName="_ReuEsbuildJsModulesExitCode" />
        </Exec>
        <Error Condition="'$(_ReuEsbuildJsModulesExitCode)' != '0'"
               Text="Minifying the component scripts with esbuild failed. It needs Node.js (npx) on the PATH. Pass -p:ReuMinifyIsolatedAssets=false to keep them as they are." />
    </Target>

    <!-- Puts the minified scripts in place of the .razor.js files just before the SDK turns those into static web assets.
         They keep the same relative paths, and the folder they are in becomes their content root, so they are served, hashed and
         packed as they are. -->
    <Target Name="_ReuUseMinifiedJsModules"
            BeforeTargets="ResolveJSModuleStaticWebAssets"
            DependsOnTargets="_ReuMinifyJsModuleFiles"
            Condition="'$(ReuMinifyIsolatedAssets)' == 'true'">
        <ItemGroup>
            <_ReuMinifiedJsModule Include="@(_ReuJsModule->'$(_ReuMinifiedJsModulesDir)%(ReuRelativePath)')" />
            <None Remove="@(_ReuJsModule)" />
            <None Include="@(_ReuMinifiedJsModule)"
                  Link="%(_ReuMinifiedJsModule.ReuRelativePath)"
                  ContentRoot="$(MSBuildProjectDirectory)\$(_ReuMinifiedJsModulesDir)" />
            <FileWrites Include="@(_ReuMinifiedJsModule)" />
        </ItemGroup>
    </Target>

</Project>
