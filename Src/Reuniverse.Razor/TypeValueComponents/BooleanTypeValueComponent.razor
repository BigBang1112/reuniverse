@inherits TypeValueComponentBase<bool?>

@if (Value.HasValue)
{
    <ReuCheckbox IsChecked="Value.Value" IsCheckedChanged="OnValueChanged" disabled="@IsReadOnly">
        @Value
    </ReuCheckbox>
}
else
{
    <button type="button"
            class="box-value clickable"
            @onclick="() => Value = default(bool)"
            data-reu-tooltip="Set to default value">@None</button>
}
@if (Exception is not null)
{
    <div style="color: var(--color-red);">@Exception.Message</div>
}

@code {
    private async Task OnValueChanged(bool isChecked)
    {
        Value = isChecked;
        await ValueChanged.InvokeAsync();
    }
}
