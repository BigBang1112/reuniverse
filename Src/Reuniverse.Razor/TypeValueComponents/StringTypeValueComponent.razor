@inherits TypeValueComponentBase<string>

@if (Value is null)
{
    <span class="box-value clickable"
          @onclick="() => Value = string.Empty"
          data-reu-tooltip="Set to empty string">@None</span>
}
else
{
    <input @bind="Value" 
           readonly="@IsReadOnly" 
           placeholder="@Placeholder" 
           @oninput="e => tempValue = e.Value?.ToString()" 
           style="width:@((tempValue?.Length ?? Value?.Length ?? 0) + 1)ch" />

    @if (!IsKey)
    {
        <span class="box-value"><code
            data-reu-tooltip="Length of the string">@Value.Length</code></span>
    }
}
@if (Exception is not null)
{
    <div style="color: var(--color-red);">@Exception.Message</div>
}

@code {
    private string? tempValue;
}