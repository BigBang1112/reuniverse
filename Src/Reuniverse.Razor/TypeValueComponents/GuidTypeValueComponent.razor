@inherits TypeValueComponentBase<Guid?>

@if (Value.HasValue)
{
    <input aria-label="@Label" @bind="Value" readonly="@IsReadOnly" style="width:36ch" />
}
else
{
    <button type="button"
            class="box-value clickable"
            @onclick="() => Value = default(Guid)"
            data-reu-tooltip="Set to default value">@None</button>
}
@if (Exception is not null)
{
    <div style="color: var(--color-red);">@Exception.Message</div>
}
