@inherits TypeValueComponentBase<Guid?>

@if (Value.HasValue)
{
    <input @bind="Value" readonly="@IsReadOnly" style="width:36ch" />
}
else
{
    <span class="box-value clickable"
          @onclick="() => Value = default(Guid)"
          data-reu-tooltip="Set to default value">@None</span>
}
@if (Exception is not null)
{
    <div style="color: var(--color-red);">@Exception.Message</div>
}
