@using Microsoft.AspNetCore.Components.Forms

@inherits TypeValueComponentBase<TimeSpan?>

@if (Value.HasValue)
{
    <input @bind="Value" readonly="@IsReadOnly" maxlength="16" style="width: 16ch;" />
}
else
{
    <span class="box-value clickable"
          @onclick="() => Value = default(TimeSpan)"
          data-reu-tooltip="Set to default value">@None</span>
}
@if (Exception is not null)
{
    <div style="color: var(--color-red);">@Exception.Message</div>
}