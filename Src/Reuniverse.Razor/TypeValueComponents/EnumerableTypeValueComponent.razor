@inherits TypeValueComponentBase<System.Collections.IEnumerable>

@if (Value is null)
{
    <span class="box-value">@None</span>
}
else 
{
    if (Value is IEnumerable<object> enumerable && enumerable.TryGetNonEnumeratedCount(out int count))
    {
        <span class="box-value"><code>@count</code> @(count == 1 ? "element" : "elements")</span>
    }
    else if (Value is System.Collections.ICollection collection)
    {
        <span class="box-value"><code>@collection.Count</code> @(collection.Count == 1 ? "element" : "elements")</span>
    }
    @if (CanAddElement())
    {
        <span class="box-value clickable add"
              @onclick="AddElementAsync"
              @onmouseenter="@(args => ReuTooltip.ShowGlobal(args, "Add element"))"
              @onmousemove="ReuTooltip.MoveGlobal"
              @onmouseout="ReuTooltip.HideGlobal">+</span>
    }
}

@if (Exception is not null)
{
    <div class="exception">@Exception.Message</div>
}

@code {
    private bool CanAddElement()
    {
        if (Value is null)
        {
            return false;
        }
        
        // arrays are fixed size, immutable and read-only collections are read-only
        if (Value is System.Collections.IList { IsReadOnly: false, IsFixedSize: false })
        {
            // dont add default element to non-generic lists yet, it would have to be object and thats confusing
            return GetElementType(Value.GetType()) is Type elementType && CanCreateElement(elementType);
        }

        return false;
    }

    private static Type? GetElementType(Type listType)
    {
        return listType.GetInterfaces()
            .FirstOrDefault(x => x.IsGenericType && x.GetGenericTypeDefinition() == typeof(IList<>))?
            .GenericTypeArguments[0];
    }

    private static bool CanCreateElement(Type elementType)
    {
        if (elementType == typeof(string) || elementType.IsValueType)
        {
            return true;
        }

        // Check if it has a parameterless constructor
        return !elementType.IsAbstract &&
               !elementType.IsInterface &&
               elementType.GetConstructor(Type.EmptyTypes) is not null;
    }

    private async Task AddElementAsync()
    {
        if (Value is not System.Collections.IList list || GetElementType(Value.GetType()) is not Type elementType)
        {
            return;
        }

        try
        {
            var newElement = elementType == typeof(string) ? string.Empty : Activator.CreateInstance(elementType);

            var index = list.Add(newElement);
            History?.RecordElementAdded(list, index, newElement);

            await ValueChanged.InvokeAsync(Value);

            Exception = null;
        }
        catch (TargetInvocationException tex)
        {
            Exception = tex.InnerException ?? tex;
        }
        catch (Exception ex)
        {
            Exception = ex;
        }
    }
}