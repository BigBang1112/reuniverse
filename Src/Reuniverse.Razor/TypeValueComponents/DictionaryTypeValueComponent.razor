@using System.Diagnostics.CodeAnalysis

@inherits TypeValueComponentBase<System.Collections.IDictionary>

@if (Value is null)
{
    <span class="box-value">@None</span>
}
else 
{
    if (Value is System.Collections.IDictionary dictionary)
    {
        <span class="box-value"><code>@dictionary.Count</code> @(dictionary.Count == 1 ? "element" : "elements")</span>
    }

    @if (CanAddElement())
    {
        @if (TryGetValueComponent(out var keyType, out var componentType))
        {
            var parameters = new Dictionary<string, object?>
            {
                ["DefaultValue"] = GetDefaultKey(keyType),
                ["Placeholder"] = "Key to add...",
                ["TypeValueComponents"] = TypeValueComponents,
                ["ValueChanged"] = EventCallback.Factory.Create(this, ValueChanged)
            };

            <DynamicComponent Type="componentType" Parameters="parameters" @ref="keyDynamicComponent" />

            <span class="box-value clickable add"
                  @onclick="AddElementAsync"
                  data-reu-tooltip="Add element">+</span>
        }
    }
}

@if (Exception is not null)
{
    <div class="exception">@Exception.Message</div>
}

@code {
    private DynamicComponent? keyDynamicComponent;

    private bool TryGetValueComponent([NotNullWhen(true)] out Type? keyType, [NotNullWhen(true)] out Type? componentType)
    {
        keyType = Value is null ? null : GetKeyValueTypes(Value.GetType())?[0];

        if (keyType is null)
        {
            componentType = null;
            return false;
        }

        return ReuObjectTree.TryGetValueComponent(value: null, keyType, TypeValueComponents, out componentType);
    }

    /// <summary>
    /// Gets the [TKey, TValue] type arguments of the dictionary, or null if it is not a generic dictionary.
    /// </summary>
    private static Type[]? GetKeyValueTypes(Type dictionaryType)
    {
        return dictionaryType.GetInterfaces()
            .FirstOrDefault(x => x.IsGenericType && x.GetGenericTypeDefinition() == typeof(IDictionary<,>))?
            .GenericTypeArguments;
    }

    private static object? GetDefaultKey(Type keyType)
    {
        if (keyType == typeof(string))
        {
            return "";
        }

        if (keyType.IsEnum)
        {
            // zero is not always a defined value, and the enum editor needs a value to know the type
            var values = Enum.GetValues(keyType);
            return values.Length > 0 ? values.GetValue(0) : Activator.CreateInstance(keyType);
        }

        return keyType.GetConstructor(Type.EmptyTypes)?.Invoke(null);
    }

    private bool CanAddElement()
    {
        // dont add default element to non-generic dictionaries yet, it would have to be object and thats confusing
        return Value is { IsReadOnly: false, IsFixedSize: false } && GetKeyValueTypes(Value.GetType()) is not null;
    }

    private async Task AddElementAsync()
    {
        if (keyDynamicComponent?.Instance is not ITypeValueComponent { Value: not null } keyComponent)
        {
            return;
        }

        if (Value is not System.Collections.IDictionary dict || GetKeyValueTypes(Value.GetType()) is not [_, var valueType])
        {
            return;
        }

        try
        {
            // non-generic Add throws on null for value type values
            var defaultValue = valueType.IsValueType ? Activator.CreateInstance(valueType) : null;

            var key = keyComponent.Value;

            dict.Add(key, defaultValue);
            History?.RecordKeyAdded(dict, key, defaultValue);
            keyComponent.Value = null;

            await ValueChanged.InvokeAsync(Value);

            Exception = null;
        }
        catch (TargetInvocationException tex)
        {
            Exception = tex.InnerException ?? tex;
        }
        catch (Exception ex)
        {
            Exception = ex;
        }
    }
}