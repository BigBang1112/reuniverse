<div class="reu-tabs @CssClass" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="true">
        <div class="header" role="tablist">
            @foreach (var tab in Tabs)
            {
                @* the click is on the whole header, but only the title is the tab, as a tab cannot hold the close button *@
                <div @key="tab" class="tab @(tab.Selected ? "selected" : "") @tab.CssClass" @onclick="() => SelectTabAsync(tab)">
                    <button type="button"
                            class="tab-title"
                            role="tab"
                            id="@tab.HeaderId"
                            aria-controls="@tab.PanelId"
                            aria-selected="@(tab.Selected ? "true" : "false")"
                            tabindex="@(tab.Selected ? "0" : "-1")"
                            aria-keyshortcuts="@(tab.ShowCloseButton ? "Delete" : null)"
                            @ref="tab.HeaderElement"
                            @onkeydown="e => HandleKeyDownAsync(e, tab)">@tab.TitleContent</button>
                    @if (tab.ShowCloseButton)
                    {
                        @* a tab list may only hold tabs, so this is only for the mouse, and Delete on the tab closes it from the keyboard *@
                        <button type="button"
                                class="tab-close-btn"
                                @onclick="() => CloseAsync(tab, fromKeyboard: false)"
                                @onclick:stopPropagation="true"
                                tabindex="-1"
                                aria-hidden="true"
                                data-reu-tooltip="Close">✕</button>
                    }
                </div>
            }
        </div>
        <div class="content">
            @ChildContent
        </div>
    </CascadingValue>
</div>

@code {
    internal List<ReuTab> Tabs { get; } = new();

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the element.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    public ReuTab? SelectedTab { get; private set; }

    // the tab closed with Delete, as the focus goes away with it
    private ReuTab? closingFromKeyboard;
    private bool focusSelectedTab;

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    internal void Register(ReuTab tab)
    {
        if (SelectedTab is null)
        {
            tab.Selected = true;
            SelectedTab = tab;
        }

        Tabs.Add(tab);
        StateHasChanged();
    }

    internal void Unregister(ReuTab tab)
    {
        var index = Tabs.IndexOf(tab);
        Tabs.Remove(tab);

        if (ReferenceEquals(SelectedTab, tab))
        {
            // the next tab has moved to this index, unless the last tab was removed
            SelectedTab = Tabs.Count > 0 ? Tabs[Math.Min(index, Tabs.Count - 1)] : null;

            if (SelectedTab is not null)
            {
                SelectedTab.Selected = true;
            }
        }

        if (ReferenceEquals(closingFromKeyboard, tab))
        {
            closingFromKeyboard = null;
            focusSelectedTab = SelectedTab is not null;
        }

        // the headers render before the tabs, so they are already out of date by the time a tab is disposed
        _ = InvokeAsync(StateHasChanged);
    }

    internal async Task SelectTabAsync(ReuTab tab)
    {
        closingFromKeyboard = null;

        foreach (var t in Tabs)
        {
            t.Selected = false;
        }

        tab.Selected = true;
        SelectedTab = tab;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseAsync(ReuTab tab, bool fromKeyboard)
    {
        closingFromKeyboard = fromKeyboard ? tab : null;
        await tab.OnClosed.InvokeAsync();
    }

    // the arrow keys move between the tabs, so that Tab can go straight on to the selected one's content
    private async Task HandleKeyDownAsync(KeyboardEventArgs e, ReuTab tab)
    {
        var index = Tabs.IndexOf(tab);

        if (index < 0)
        {
            return;
        }

        if (e.Key == "Delete" && tab.ShowCloseButton)
        {
            await CloseAsync(tab, fromKeyboard: true);
            return;
        }

        var next = e.Key switch
        {
            "ArrowRight" => (index + 1) % Tabs.Count,
            "ArrowLeft" => (index - 1 + Tabs.Count) % Tabs.Count,
            "Home" => 0,
            "End" => Tabs.Count - 1,
            _ => -1
        };

        if (next < 0)
        {
            return;
        }

        // before selecting, in case the render it asks for runs before it returns
        focusSelectedTab = true;
        await SelectTabAsync(Tabs[next]);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusSelectedTab)
        {
            return;
        }

        focusSelectedTab = false;

        if (SelectedTab is not null)
        {
            await SelectedTab.HeaderElement.FocusAsync();
        }
    }
}
