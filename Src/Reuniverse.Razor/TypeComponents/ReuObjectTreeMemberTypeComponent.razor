@inherits TypeComponentBase<ReuObjectTreeMember>
@inject IJSRuntime JS

@if (!HideType)
{
    <div class="box type">
        <ReuFriendlyType Type="Value.Property.PropertyType" OnClick="OnTypeClick"></ReuFriendlyType>
        @if (!Value.Property.PropertyType.IsValueType && GetNullabilityInfo(Value.Property).ReadState is NullabilityState.Nullable)
        {
            <span>?</span>
        }
    </div>
}
<div class="box general @(Selected ? "active" : "")" @onclick="() => OnSelect.InvokeAsync(Value)">@Value.Property.Name</div>
@if (IsExpandable)
{
    <div @onclick="OnExpandToggle" class="box general expander @(IsExpanded ? "active" : "")">
        @(IsExpanded ? "▼" : "▶")
    </div>
}
@try
{
    @if (!revealed && VisualizationProvider?.Invoke(Value) is RenderFragment renderFragment)
    {
        <span class="box-value clickable"
              @onclick="Reveal"
              data-reu-tooltip="Reveal the actual value">
            @renderFragment
        </span>
    }
    else if (TryGetValueComponent(out var componentType))
    {
        var parameters = new Dictionary<string, object?>
        {
            ["Member"] = Value,
            ["TypeValueComponents"] = TypeValueComponents,
            ["ValueChanged"] = EventCallback.Factory.Create(this, ValueChanged),
            ["History"] = History
        };

        <DynamicComponent Type="componentType" Parameters="parameters" />
    }
    else if (Value.Value is null)
    {
        @if (CanCreateInstance())
        {
            <span class="box-value clickable"
                  @onclick="CreateInstance"
                  data-reu-tooltip="Create a new instance">
                @(Value.Property.CanRead ? "null" : "(cannot get)")
            </span>
        }
        else
        {
            <span class="box-value">@(Value.Property.CanRead ? "null" : "(cannot get)")</span>
        }
    }
    else
    {
        <span class="box-value">@(Value.Property.CanRead ? Value.Value : "(cannot get)")</span>
    }

    @if (revealed)
    {
        <span class="box-value clickable" @onclick="() => revealed = false">Visualize</span>
    }

    @if (ExtrasProvider?.Invoke(Value) is RenderFragment extrasFragment)
    {
        @extrasFragment
    }

    @if (CanRemoveValue())
    {
        <span class="box-value clickable remove"
              @onclick="RemoveValueAsync"
              data-reu-tooltip="Set to null">✕</span>
    }

    @if (prevValue is not null)
    {
        <span class="box-value clickable" @onclick="RevertValueAsync">Revert</span>
    }

    @if (!HideType && IsDifferentType(out var actualType))
    {
        <span class="box-value type"><ReuFriendlyType Type="actualType" OnClick="OnTypeClick"></ReuFriendlyType></span>
    }
}
catch (Exception ex)
{
    Exception = ex.InnerException ?? ex;
}
@if (Exception is not null)
{
    <div class="box-value error">@Exception.Message</div>
}

@code {
    // this prevValue will be forgotten after the component is recreated, prefer storing it in separate class (not ReuObjectTreeMember as that one recreates too)
    private object? prevValue;

    private bool revealed;

    private void Reveal()
    {
        revealed = true;
    }

    private bool TryGetValueComponent(out Type? componentType)
    {
        var type = Value.Value?.GetType() ?? Value.Property.PropertyType;

        return ReuObjectTree.TryGetValueComponent(Value.Value, type, TypeValueComponents, out componentType);
    }

    private bool CanCreateInstance()
    {
        if (!Value.Property.CanWrite)
        {
            return false;
        }

        var propertyType = Value.Property.PropertyType;

        // Handle nullable types
        if (Nullable.GetUnderlyingType(propertyType) is Type underlyingType)
        {
            propertyType = underlyingType;
        }

        // Check if it has a parameterless constructor
        if (!propertyType.IsAbstract && 
            !propertyType.IsInterface && 
            propertyType.GetConstructor(Type.EmptyTypes) is not null)
        {
            return true;
        }

        if (propertyType.Name == "ImmutableArray`1" && propertyType.IsGenericType && propertyType.GetGenericTypeDefinition() == typeof(System.Collections.Immutable.ImmutableArray<>))
        {
            return false;
        }

        // Try struct default for struct types in case no other conditions meet
        return propertyType.IsValueType && !propertyType.IsEnum;
    }

    private async Task CreateInstance()
    {
        if (!CanCreateInstance() || !Value.Property.CanWrite)
        {
            return;
        }

        try
        {
            var propertyType = Value.Property.PropertyType;

            // Handle nullable types
            if (Nullable.GetUnderlyingType(propertyType) is Type underlyingType)
            {
                propertyType = underlyingType;
            }

            var newInstance = Activator.CreateInstance(propertyType);
            var oldValue = Value.Value;
            Value.Property.SetValue(Value.Parent, newInstance);
            History?.RecordProperty(Value.Parent, Value.Property, oldValue, newInstance);

            await ValueChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Exception = ex;
        }
    }

    private bool CanRemoveValue()
    {
        if (!Value.Property.CanWrite || Value.Value is null)
        {
            return false;
        }

        var propertyType = Value.Property.PropertyType;

        // Can remove only if it's a nullable reference type
        if (propertyType.IsValueType)
        {
            // Only allow removing nullable value types (like int?, DateTime?)
            return Nullable.GetUnderlyingType(propertyType) is not null;
        }

        // For reference types, check if it's nullable using NullabilityInfo
        return GetNullabilityInfo(Value.Property).WriteState is NullabilityState.Nullable;
    }

    // NullabilityInfoContext is not thread-safe, so a new one is created only on cache miss
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<PropertyInfo, NullabilityInfo> nullabilityCache = new();

    private static NullabilityInfo GetNullabilityInfo(PropertyInfo property)
    {
        return nullabilityCache.GetOrAdd(property, static p => new NullabilityInfoContext().Create(p));
    }

    private async Task RemoveValueAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to set '{Value.Property.Name}' to null?");

        if (!confirmed)
        {
            return;
        }

        if (!CanRemoveValue())
        {
            return;
        }

        await SetValueAsync(null);
    }

    private bool IsDifferentType([System.Diagnostics.CodeAnalysis.NotNullWhen(true)] out Type? actualType)
    {
        if (Value.Value is null)
        {
            actualType = null;
            return false;
        }

        var propertyType = Value.Property.PropertyType;
        actualType = Value.Value.GetType();

        // Check if property type is nullable and actual type is the underlying type
        var underlyingType = Nullable.GetUnderlyingType(propertyType);

        if (underlyingType is not null && underlyingType == actualType)
        {
            return false;
        }

        return propertyType != actualType;
    }

    private async Task RevertValueAsync()
    {
        if (prevValue is null)
        {
            return;
        }
        
        await SetValueAsync(prevValue);
    }

    private async Task SetValueAsync(object? value)
    {
        if (!Value.Property.CanWrite)
        {
            return;
        }

        var prevPrevValue = prevValue;
        prevValue = Value.Value;

        try
        {
            Value.Property.SetValue(Value.Parent, value);
            History?.RecordProperty(Value.Parent, Value.Property, prevValue, value);
            await ValueChanged.InvokeAsync();
        }
        catch (TargetInvocationException ex)
        {
            Exception = ex;
            prevValue = prevPrevValue;
        }
    }
}
