@inherits TypeComponentBase<ReuObjectTreeItem>
@inject IJSRuntime JS

@if (!HideType && Value.Value is not null)
{
    <div class="box type">
        <ReuFriendlyType Type="Value.Value.GetType()" OnClick="OnTypeClick"></ReuFriendlyType>
    </div>
}
<code class="box general @(Selected ? "active" : "")" @onclick="() => OnSelect.InvokeAsync(Value)">#@Value.Index</code>
@if (IsExpandable)
{
    <div @onclick="OnExpandToggle" class="box general expander @(IsExpanded ? "active" : "")">
        @(IsExpanded ? "▼" : "▶")
    </div>
}
@if (!revealed && VisualizationProvider?.Invoke(Value) is RenderFragment renderFragment)
{
    <span class="box-value clickable"
    @onclick="Reveal"
    data-reu-tooltip="Reveal the actual value">
        @renderFragment
    </span>
}
else if (TryGetValueComponent(out var componentType))
{
    var parameters = new Dictionary<string, object?>
                {
                    ["Item"] = Value,
                    ["TypeValueComponents"] = TypeValueComponents,
                    ["ValueChanged"] = EventCallback.Factory.Create(this, ValueChanged),
                    ["History"] = History
                };

    <DynamicComponent Type="componentType" Parameters="parameters" />
}
else
{
    @try
    {
        var valueStr = Value.Value?.ToString();

        if (valueStr is null)
        {
            <span class="box-value">null</span>
        }
        else
        {
            <span class="box-value">@valueStr</span>
        }
    }
    catch (Exception ex)
    {
        Exception = ex.InnerException ?? ex;
    }
}
@if (revealed)
{
    <span class="box-value clickable" @onclick="() => revealed = false">Visualize</span>
}
@if (ExtrasProvider?.Invoke(Value) is RenderFragment extrasFragment)
{
    @extrasFragment
}
@if (CanRemoveValue())
{
    <span class="box-value clickable remove"
          @onclick="RemoveValueAsync"
          data-reu-tooltip="Remove element">✕</span>
}
@if (Exception is not null)
{
    <div class="box-value error">
        @Exception.Message
    </div>
}

@code {
    private bool revealed;

    private void Reveal()
    {
        revealed = true;
    }

    private bool TryGetValueComponent(out Type? componentType)
    {
        if (Value.Value is null)
        {
            componentType = null;
            return false;
        }

        var type = Value.Value.GetType();

        return ReuObjectTree.TryGetValueComponent(Value.Value, type, TypeValueComponents, out componentType);
    }

    private bool CanRemoveValue()
    {
        // arrays are fixed size, immutable and read-only collections are read-only
        return Value.Parent is System.Collections.IList { IsReadOnly: false, IsFixedSize: false };
    }

    private async Task RemoveValueAsync()
    {
        if (Value.Parent is not System.Collections.IList list)
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to remove #{Value.Index}?");

        if (!confirmed)
        {
            return;
        }

        try
        {
            // the list could have changed since rendering or while confirming, so the index may be another element now
            if (Value.Index < list.Count && Equals(list[Value.Index], Value.Value))
            {
                list.RemoveAt(Value.Index);
                History?.RecordElementRemoved(list, Value.Index, Value.Value);
            }

            await ValueChanged.InvokeAsync(Value);
        }
        catch (Exception ex)
        {
            Exception = ex;
        }
    }
}
