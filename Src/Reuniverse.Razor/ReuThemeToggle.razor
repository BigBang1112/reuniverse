<button type="button" class="reu-theme-toggle @CssClass" onclick="reuTheme.toggle()"
        aria-label="@(Tooltip ?? DefaultTooltip)" data-reu-tooltip="@Tooltip" @attributes="AdditionalAttributes">
    <span class="reu-theme-icon" style="width: @(Size)px; height: @(Size)px;" aria-hidden="true"></span>
</button>

@code {
    private const string DefaultTooltip = "Switch theme";

    /// <summary>
    /// The size of the lightbulb icon in pixels.
    /// </summary>
    [Parameter]
    public int Size { get; set; } = 20;

    /// <summary>
    /// The tooltip text to display on hover or keyboard focus, also used as the accessible label. Null shows no tooltip.
    /// </summary>
    [Parameter]
    public string? Tooltip { get; set; } = DefaultTooltip;

    /// <summary>
    /// Additional CSS classes to apply to the button.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
