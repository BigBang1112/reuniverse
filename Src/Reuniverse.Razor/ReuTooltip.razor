<span data-reu-tooltip="@Text" @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    /// <summary>
    /// The text to show while the content is hovered or focused.
    /// </summary>
    [Parameter, EditorRequired]
    public string? Text { get; set; }

    /// <summary>
    /// The content the tooltip belongs to.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
