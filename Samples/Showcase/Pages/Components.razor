    private readonly byte[] hexData = CreateHexData();

    private readonly ReuHexHighlight[] hexHighlights =
    [
        new(0, 3, Tooltip: "Magic"),
        new(3, 2, "color-mix(in srgb, var(--color-blue) 40%, transparent)", "Version"),
