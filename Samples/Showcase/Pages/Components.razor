@page "/components"
@inject ReuDialogService Dialogs
@layout MainLayout

<PageTitle>Components - Reuniverse</PageTitle>

<div class="components">
    <div>
        <h2 class="element">&lt;ReuCheckbox&gt;</h2>
    </div>
    <div>
        <ReuCheckbox>Should do this?</ReuCheckbox>
        <ReuCheckbox disabled>Should do this?</ReuCheckbox>
    </div>
    <div>
        <h2 class="element">&lt;ReuRadio&gt;</h2>
    </div>
    <div>
        <ReuRadio Name="Rad">Option 1</ReuRadio>
        <ReuRadio Name="Rad">Option 2</ReuRadio>
        <ReuRadio Name="Rad" disabled>Option 3</ReuRadio>
        <ReuRadio Name="Rad">Option 4</ReuRadio>
    </div>
    <div>
        <h2 class="element">&lt;ReuButton&gt;</h2>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
        <ReuButton Tooltip="This button is enabled">Enabled button</ReuButton>
        <ReuButton Enable="false">Disabled button</ReuButton>
        <ReuButton Variant="ReuButtonVariant.Blue" Enable="false">Disabled blue button</ReuButton>
        <ReuButton Variant="ReuButtonVariant.Red">Red button</ReuButton>

        <ReuButton Href="https://gbx.tools" Variant="ReuButtonVariant.Yellow">Enabled link</ReuButton>
        <ReuButton Href="https://gbx.tools" Variant="ReuButtonVariant.Yellow" Enable="false">Disabled link</ReuButton>
    </div>
    <div>
        <h2 class="element">&lt;ReuExpansionPanels&gt;</h2>
    </div>
    <div>
        <ReuExpansionPanels>
            <ReuExpansionPanel>
                <TitleContent>
                    Expansion Panel 1
                </TitleContent>
                <ChildContent>
                    This is the content of Expansion Panel 1.
                </ChildContent>
            </ReuExpansionPanel>
            <ReuExpansionPanel>
                <TitleContent>
                    Expansion Panel 2
                </TitleContent>
                <ChildContent>
                    This is the content of Expansion Panel 2.
                </ChildContent>
            </ReuExpansionPanel>
            <ReuExpansionPanel>
                <TitleContent>
                    Expansion Panel 3
                </TitleContent>
                <ChildContent>
                    This is the content of Expansion Panel 3.
                </ChildContent>
            </ReuExpansionPanel>
        </ReuExpansionPanels>
    </div>
    <div>
        <h2 class="element">&lt;ReuTabs&gt;</h2>
    </div>
    <div>
        <ReuTabs>
            <ReuTab>
                <TitleContent>
                    Tab 1
                </TitleContent>
                <ChildContent>
                    This is the content of Tab 1.
                </ChildContent>
            </ReuTab>
            <ReuTab>
                <TitleContent>
                    Tab 2
                </TitleContent>
                <ChildContent>
                    This is the content of Tab 2.
                </ChildContent>
            </ReuTab>
            @if (showClosableTab)
            {
                <ReuTab ShowCloseButton="true" OnClosed="CloseNotesTabAsync">
                    <TitleContent>
                        Notes
                    </TitleContent>
                    <ChildContent>
                        <input @bind="notes" @bind:event="oninput" placeholder="Type something, then close the tab" aria-label="Notes" />
                    </ChildContent>
                </ReuTab>
            }
        </ReuTabs>
    </div>
    <div>
        <h2 class="element">&lt;ReuList&gt;</h2>
    </div>
    <div>
        <ReuList Panel="true" Wrap="true">
            <ReuListItem>TMSX</ReuListItem>
            <ReuListItem>TMNESWC</ReuListItem>
            <ReuListItem>TMUF</ReuListItem>
            <ReuListItem>TMT</ReuListItem>
            <ReuListItem>MP4</ReuListItem>
            <ReuListItem>TM2020</ReuListItem>
        </ReuList>
        <ReuList Panel="true" Vertical="true" Grow="false" style="height: 100px">
            <ReuListItem>A</ReuListItem>
            <ReuListItem>B</ReuListItem>
            <ReuListItem>C</ReuListItem>
            <ReuListItem>D</ReuListItem>
            <ReuListItem>E</ReuListItem>
            <ReuListItem>F</ReuListItem>
        </ReuList>
    </div>
    <div>
        <h2 class="element">&lt;ReuUploadButton&gt;</h2>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
        <ReuUploadButton>Open files...</ReuUploadButton>
        <ReuUploadButton Streamed OnStream="ReadStreamedAsync" MaxFileCount="1">Open a file streamed...</ReuUploadButton>
        @if (streamedInfo is not null)
        {
            <span class="streamed-info">@streamedInfo</span>
        }
    </div>
    <div>
        <h2 class="element">&lt;ReuUploadArea&gt;</h2>
    </div>
    <div>
        <ReuUploadArea><span class="upload-text">Drop files here or click to browse</span></ReuUploadArea>
    </div>
    <div>
        <h2 class="element">&lt;ReuLoader&gt;</h2>
    </div>
    <div>
        <ReuLoader></ReuLoader>
    </div>
    <div>
        <h2 class="element">&lt;ReuFriendlyType&gt;</h2>
    </div>
    <div>
        <ReuFriendlyType Type="typeof(Dictionary<string, List<int>>)"></ReuFriendlyType>
    </div>
    <div>
        <h2 class="element">&lt;ReuMenuBar&gt;</h2>
    </div>
    <div>
        <ReuMenuBar Items="items"></ReuMenuBar>
    </div>
    <div>
        <h2 class="element">&lt;ReuFileBrowser&gt;</h2>
    </div>
    <div>
        <ReuFileBrowser Root="sampleRoot" OnFileOpen="f => lastOpened = f.Name" style="height: 340px"></ReuFileBrowser>
        @if (lastOpened is not null)
        {
            <p class="file-opened-hint">Opened: <strong>@lastOpened</strong></p>
        }
    </div>
    <div>
        <h2 class="element">&lt;ReuLogs&gt;</h2>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            <ReuButton OnClick="LogSamples">Log all levels</ReuButton>
            <ReuButton OnClick="LogParameterized">Log parameterized</ReuButton>
            <ReuButton Variant="ReuButtonVariant.Red" OnClick="LogException">Log exception</ReuButton>
            <ReuButton OnClick="LogScoped">Log with scopes</ReuButton>
            <ReuButton OnClick="() => logProvider.Clear()">Clear</ReuButton>
        </div>
    </div>
    <div>
        <ReuLogs Provider="logProvider"
                 OnEntryClick="e => clickedException = e.Exception?.ToString()"
                 OnParameterClick='p => clickedParameter = $"{p.Name} = {p.Value}"'
                 style="height: 340px"></ReuLogs>
        @if (clickedException is not null)
        {
            <p class="file-opened-hint">Clicked exception:</p>
            <pre style="overflow: auto; max-height: 160px;">@clickedException</pre>
        }
        @if (clickedParameter is not null)
        {
            <p class="file-opened-hint">Clicked parameter: <strong>@clickedParameter</strong></p>
        }
    </div>
    <div>
        <h2 class="element">&lt;ReuObjectTree&gt;</h2>
        <ReuCheckbox IsCheckedChanged="OnTypesChanged" IsChecked="@showTypes">Types</ReuCheckbox>
        <div class="undo-redo">
            <ReuButton Enable="history.CanUndo" OnClick="() => history.Undo()">Undo</ReuButton>
            <ReuButton Enable="history.CanRedo" OnClick="() => history.Redo()">Redo</ReuButton>
        </div>
    </div>
    <div style="overflow: auto">
        <ReuObjectTree Value="obj" HideType="!showTypes" IsExpandedByDefault="true" History="history" Dialogs="Dialogs"></ReuObjectTree>
    </div>
    <div>
        <h2 class="element">&lt;ReuSplitPane&gt;</h2>
    </div>
    <div>
        <ReuSplitPane Border="false" Size="35%" FirstMinSize="80px" SecondMinSize="120px" StorageKey="showcase" style="height: 180px">
            <FirstContent><div class="split-text">Files</div></FirstContent>
            <SecondContent>
                <ReuSplitPane Vertical="true" Border="false" Size="60%" FirstMinSize="40px" SecondMinSize="40px" style="height: 100%">
                    <FirstContent><div class="split-text">Details</div></FirstContent>
                    <SecondContent><div class="split-text">Logs</div></SecondContent>
                </ReuSplitPane>
            </SecondContent>
        </ReuSplitPane>
    </div>
    <div>
        <h2 class="element">&lt;ReuDataTable&gt;</h2>
    </div>
    <div style="min-width: 0">
        <ReuDataTable Items="records" PageSize="5" MinWidth="28rem" RowClass="@(record => record.Removed ? "removed-record" : null)">
            <ReuDataColumn Title="#" Value="record => record.Rank" Fit="true" DefaultSort="ReuSortDirection.Ascending" />
            <ReuDataColumn Title="Player" Value="record => record.Nickname" Secondary="record => record.Login" />
            <ReuDataColumn Title="Time" Value="record => record.Time" Format="m\:ss\.fff" Secondary="@(record => record.Removed ? "(removed)" : null)" />
            <ReuDataColumn Title="Driven" Value="record => record.Driven" Format="yyyy-MM-dd" />
            <ReuDataColumn Title="Download" HideTitle="true" Fit="true" Context="record">
                <ReuButton Href="@($"#{record.Login}")">Replay</ReuButton>
            </ReuDataColumn>
        </ReuDataTable>
    </div>
    <div>
        <h2 class="element">&lt;ReuHexEditor&gt;</h2>
        <div class="undo-redo">
            <ReuButton Enable="hexHistory.CanUndo" OnClick="() => hexHistory.Undo()">Undo</ReuButton>
            <ReuButton Enable="hexHistory.CanRedo" OnClick="() => hexHistory.Redo()">Redo</ReuButton>
        </div>
    </div>
    <div>
        <ReuHexEditor Data="hexData" Highlights="hexHighlights" History="hexHistory" style="height: 260px"></ReuHexEditor>
    </div>
    <div>
        <h2 class="element">ReuDialogService</h2>
    </div>
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;">
        <ReuButton OnClick="AskAsync">Ask</ReuButton>
        <ReuButton Variant="ReuButtonVariant.Red" OnClick="AskDestructiveAsync">Ask to discard</ReuButton>
        @if (lastAnswer is not null)
        {
            <span>Answered: <strong>@lastAnswer</strong></span>
        }
    </div>
    <div>
        <h2 class="element">&lt;ReuModal&gt;</h2>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
        <ReuButton OnClick="() => modalOpen = true">Open modal</ReuButton>
        <ReuButton OnClick="() => modalNoFooterOpen = true">Open modal (no footer)</ReuButton>
        <ReuButton OnClick="() => modalFullscreenOpen = true">Open modal (fullscreen)</ReuButton>
    </div>
    <div>
        <h2>Error panel</h2>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
        <ReuButton Variant="ReuButtonVariant.Red" OnClick="ThrowUnhandledError">Throw unhandled error</ReuButton>
    </div>
</div>

<ReuModal @bind-IsOpen="modalOpen" Title="Example Modal">
    <ChildContent>
        <p>This is the modal body. It supports any Blazor content.</p>
        <p style="color: var(--color-text-secondary); margin-top: 0.5rem;">Scrollable when content overflows, backdrop click or ✕ to close.</p>
    </ChildContent>
    <FooterContent>
        <div class="modal-actions">
            <ReuButton OnClick="() => modalOpen = false">Close</ReuButton>
            <ReuButton Variant="ReuButtonVariant.Blue" OnClick="() => modalOpen = false">Confirm</ReuButton>
        </div>
    </FooterContent>
</ReuModal>

<ReuModal @bind-IsOpen="modalNoFooterOpen" Title="No Footer" ShowCloseButton="true">
    <ChildContent>
        <p>This modal has no footer — only the header close button.</p>
    </ChildContent>
</ReuModal>

<ReuModal @bind-IsOpen="modalFullscreenOpen" Title="Fullscreen Modal" ShowCloseButton="true" MaxWidth="100%" Height="100%">
    <ChildContent>
        <p>This modal is fullscreen.</p>
        <p style="color: var(--color-text-secondary); margin-top: 0.5rem;">Backdrop click or ✕ to close.</p>
    </ChildContent>
</ReuModal>

@code {
    private readonly ReuObjectTreeHistory history = new();
    private readonly ReuObjectTreeHistory hexHistory = new();

    private string notes = "";
    private string? lastAnswer;

    private async Task CloseNotesTabAsync()
    {
        if (notes.Length == 0 || await Dialogs.ConfirmAsync("Discard your notes?", new ReuConfirmOptions { Title = "Unsaved notes", ConfirmText = "Discard", Destructive = true }))
        {
            notes = "";
            showClosableTab = false;
        }
    }

    private async Task AskAsync()
    {
        var confirmed = await Dialogs.ConfirmAsync("Continue with the import?", new ReuConfirmOptions { ConfirmText = "Continue" });
        lastAnswer = confirmed ? "Continue" : "Cancel";
    }

    private async Task AskDestructiveAsync()
    {
        var confirmed = await Dialogs.ConfirmAsync("Discard changes?", new ReuConfirmOptions { ConfirmText = "Discard", Destructive = true });
        lastAnswer = confirmed ? "Discard" : "Cancel";
    }

    private sealed record ShowcaseRecord(int Rank, string Nickname, string Login, TimeSpan Time, DateTime Driven, bool Removed = false);

    private readonly ShowcaseRecord[] records =
    [
        new(1, "BigBang1112", "bigbang1112", TimeSpan.FromMilliseconds(43_120), new(2026, 10, 3)),
        new(2, "Hylis", "hylis", TimeSpan.FromMilliseconds(43_480), new(2026, 9, 21)),
        new(3, "riolu", "riolu_tm", TimeSpan.FromMilliseconds(43_910), new(2026, 10, 30)),
        new(4, "Mime", "mime.tm", TimeSpan.FromMilliseconds(44_050), new(2026, 8, 12), Removed: true),
        new(5, "Scrapie", "scrapie", TimeSpan.FromMilliseconds(44_200), new(2026, 7, 2)),
        new(6, "Wosile", "wosile", TimeSpan.FromMilliseconds(44_730), new(2026, 11, 1)),
        new(7, "Bren", "bren_tm", TimeSpan.FromMilliseconds(45_010), new(2026, 6, 18)),
        new(8, "Gwen", "gwen", TimeSpan.FromMilliseconds(45_320), new(2026, 5, 9))
