{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Showcase: Debug (Edge)",
            "type": "blazorwasm",
            "request": "launch",
            "cwd": "${workspaceFolder}/Samples/Showcase",
            "browser": "edge",
            "presentation": {
                "group": "Showcase",
                "order": 1
            }
        },
        {
            "name": "Showcase: Watch",
            "type": "node-terminal",
            "request": "launch",
            "command": "dotnet watch --launch-profile http",
            "cwd": "${workspaceFolder}/Samples/Showcase",
            "env": {
                "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "1"
            },
            "presentation": {
                "group": "Showcase",
                "order": 2
            }
        },
        {
            "name": "Showcase: Watch (Integrated Browser)",
            "type": "node-terminal",
            "request": "launch",
            "command": "dotnet watch --launch-profile http",
            "cwd": "${workspaceFolder}/Samples/Showcase",
            "env": {
                "DOTNET_WATCH_SUPPRESS_LAUNCH_BROWSER": "1",
                "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "1"
            },
            "serverReadyAction": {
                "action": "openIntegratedBrowser",
                "pattern": "Now listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            },
            "presentation": {
                "group": "Showcase",
                "order": 3
            }
        },
